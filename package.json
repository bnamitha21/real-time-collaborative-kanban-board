{
  "name": "real-time-collaborative-kanban-board",
  "private": true,
  "workspaces": [
    "client"
  ],
  "scripts": {
    "dev:server": "python -m server.src.main",
    "dev:client": "npm run dev -w client",
    "build:client": "npm run build -w client",
    "typecheck:client": "npm run typecheck -w client",
    "typecheck:server": "mypy server/src",
    "lint:server": "ruff check server",
    "test:server": "pytest server/tests",
    "test:client": "npm run test -w client",
    "db:setup": "python scripts/init_db.py --seed",
    "db:start": "powershell -ExecutionPolicy Bypass -File scripts/start_db.ps1",
    "db:stop": "powershell -ExecutionPolicy Bypass -File scripts/stop_db.ps1",
    "db:status": "powershell -ExecutionPolicy Bypass -File scripts/status_db.ps1",
    "db:migrate": "python -m server.src.db.migrate",
    "db:seed": "python -m server.src.db.seed"
  }
}
